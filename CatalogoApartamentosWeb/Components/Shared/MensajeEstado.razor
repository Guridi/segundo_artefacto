@if (Cargando)
{
    <div class="estado">
        <div class="spinner-border text-primary" role="status"></div>
        <p>Cargando información…</p>
    </div>
}
else if (!string.IsNullOrEmpty(Error))
{
    <div class="alert alert-danger d-flex justify-content-between align-items-center">
        <span>@Error</span>
        @if (OnReintentar.HasDelegate)
        {
            <button class="btn btn-sm btn-outline-danger" @onclick="OnReintentar">Reintentar</button>
        }
    </div>
}
else if (Vacio)
{
    <div class="alert alert-info">@MensajeVacio</div>
}
else
{
    @ChildContent
}

@code {
    [Parameter]
    public bool Cargando { get; set; }

    [Parameter]
    public string? Error { get; set; }

    [Parameter]
    public bool Vacio { get; set; }

    [Parameter]
    public string MensajeVacio { get; set; } = "No hay información para mostrar.";

    [Parameter]
    public EventCallback OnReintentar { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
